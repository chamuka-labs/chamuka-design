{
  "name": "@chamuka/icons",
  "version": "0.2.0",
  "type": "module",
  "description": "Daybreak mark, lockups, and product marks as React components.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/chamuka-labs/chamuka-design/tree/main/packages/icons",
  "repository": {
    "type": "git",
    "url": "https://github.com/chamuka-labs/chamuka-design.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "tsx src/generate.ts",
    "build": "tsx src/generate.ts && tsup && node ../../scripts/prepend-use-client.mjs dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "react": "^19.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

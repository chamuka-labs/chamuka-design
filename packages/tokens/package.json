{
  "name": "@chamuka/tokens",
  "version": "0.2.0",
  "type": "module",
  "description": "Daybreak design tokens for Chamuka Labs products.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/chamuka-labs/chamuka-design/tree/main/packages/tokens",
  "repository": {
    "type": "git",
    "url": "https://github.com/chamuka-labs/chamuka-design.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js",
      "require": "./dist/preset.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "src/tokens",
    "README.md"
  ],
  "scripts": {
    "build": "tsx src/build.ts && tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "220ms" },
      "slow": { "$value": "480ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.2, 0.7, 0.1, 1] },
      "standard": { "$value": [0.2, 0.7, 0.1, 1] }
    }
  }
}
